[core]
	repositoryformatversion = 0
	filemode = false
	bare = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/bh2005/alarmserver.git
	tagOpt = --no-tags
	fetch = +refs/*:refs/*
	mirror = true
[remote "github"]
	url = https://github.com/bh2005/Alarmserver.git
	fetch = +refs/heads/*:refs/remotes/github/*
