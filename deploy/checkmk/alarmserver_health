#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Check_MK Local Check — Alarmserver Health
==========================================
Überwacht den /health-Endpoint des Alarmservers und gibt die Ergebnisse
als Check_MK Local-Check-Zeilen aus.

Installation (auf dem Host, auf dem der Alarmserver läuft):
  cp alarmserver_health /usr/lib/check_mk_agent/local/
  chmod +x /usr/lib/check_mk_agent/local/alarmserver_health

Konfiguration via Umgebungsvariablen (oder direkt im Script anpassen):
  ALARMSERVER_URL      http://localhost:8080   (default)
  ALARMSERVER_TIMEOUT  5                       (Sekunden, default)

Format einer Local-Check-Zeile:
  <status> <service_name> <perfdata|-> <summary>
  Status: 0=OK, 1=WARN, 2=CRIT, 3=UNKNOWN
"""
import json
import os
import sys
import urllib.request
import urllib.error

BASE_URL = os.environ.get("ALARMSERVER_URL", "http://localhost:8080").rstrip("/")
TIMEOUT  = int(os.environ.get("ALARMSERVER_TIMEOUT", "5"))

def local(status: int, name: str, perfdata: str, summary: str) -> None:
    print(f"{status} {name} {perfdata} {summary}")

def check() -> None:
    url = f"{BASE_URL}/health"
    try:
        req = urllib.request.Request(url, headers={"Accept": "application/json"})
        with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
            http_status = resp.status
            raw = resp.read()
    except urllib.error.URLError as e:
        local(2, "alarmserver_health", "-", f"CRIT - Alarmserver nicht erreichbar: {e.reason}")
        return
    except Exception as e:
        local(3, "alarmserver_health", "-", f"UNKNOWN - {e}")
        return

    # HTTP 503 → mindestens ein Check hat versagt
    if http_status not in (200, 503):
        local(2, "alarmserver_health", "-", f"CRIT - HTTP {http_status}")
        return

    try:
        data = json.loads(raw)
    except Exception:
        local(3, "alarmserver_health", "-", "UNKNOWN - Ungültige JSON-Antwort")
        return

    # ── DB ──────────────────────────────────────────────────────────────────
    db = data.get("db", "missing")
    if db == "ok":
        local(0, "alarmserver_db", "-", "OK - Datenbankverbindung OK")
    else:
        local(2, "alarmserver_db", "-", f"CRIT - DB: {db}")

    # ── Regeln ──────────────────────────────────────────────────────────────
    rules_val = data.get("rules", "")
    if rules_val.startswith("ok:"):
        count_str = rules_val.split(":")[1].strip().split()[0]
        try:
            count = int(count_str)
        except ValueError:
            count = 0
        perfdata = f"active_rules={count}"
        if count == 0:
            local(1, "alarmserver_rules", perfdata, f"WARN - Keine aktiven Regeln")
        else:
            local(0, "alarmserver_rules", perfdata, f"OK - {count} aktive Regeln")
    elif rules_val:
        local(2, "alarmserver_rules", "-", f"CRIT - {rules_val}")

    # ── Event-Queue ──────────────────────────────────────────────────────────
    queue_val = data.get("event_queue", "")
    if queue_val.startswith("ok:"):
        parts = queue_val.split(":")[1].strip().split("/")
        try:
            used, cap = int(parts[0]), int(parts[1])
        except (ValueError, IndexError):
            used, cap = 0, 0
        perfdata = f"queue_used={used};{int(cap*0.8)};{int(cap*0.9)};0;{cap}"
        local(0, "alarmserver_queue", perfdata, f"OK - Queue {used}/{cap}")
    elif queue_val.startswith("warn:"):
        local(1, "alarmserver_queue", "-", f"WARN - {queue_val}")
    elif queue_val:
        local(2, "alarmserver_queue", "-", f"CRIT - {queue_val}")

    # ── Notifier ─────────────────────────────────────────────────────────────
    notif_val = data.get("notifiers", "")
    if notif_val.startswith("ok:"):
        channels = notif_val.split(":")[1].strip()
        count = len(channels.split(","))
        local(0, "alarmserver_notifiers", f"notifier_count={count}", f"OK - {channels}")
    elif notif_val.startswith("warn:"):
        local(1, "alarmserver_notifiers", "notifier_count=0", f"WARN - {notif_val}")
    elif notif_val:
        local(2, "alarmserver_notifiers", "-", f"CRIT - {notif_val}")

check()
