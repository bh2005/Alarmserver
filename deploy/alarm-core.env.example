# Copy to /etc/alarm-core/alarm-core.env and fill in the secrets below.
# install-alarm-core.sh does this automatically on first install.

ALARM_DB_DSN=postgres://alarmcore:CHANGE_ME@localhost:5432/alarmcore
ALARM_LISTEN_ADDR=:8080

# Required for any non-localhost deployment: /api/events, /api/announcements
# and /api/acknowledgements refuse all requests without this key (as
# "Authorization: Bearer <key>" or "X-API-Key: <key>"). /health stays open.
# If left empty, the API runs UNAUTHENTICATED — fine for a quick local test,
# never for anything reachable from elsewhere. Generate one with:
#   openssl rand -hex 32
ALARM_API_KEY=

# UI login. ALARM_SESSION_SECRET signs session tokens — if left empty, a
# random one is generated at every process start, which logs everyone out
# on each restart. Generate a persistent one with: openssl rand -hex 32
ALARM_SESSION_SECRET=
# First admin account, created automatically only if the users table is
# still empty (i.e. on first start). Change the password via the UI
# afterwards — these env vars are only read once.
ALARM_ADMIN_USERNAME=admin
ALARM_ADMIN_PASSWORD=admin123

# Voice channel (Asterisk AMI). Empty by default — disabled until you set
# ASTERISK_HOST (e.g. 127.0.0.1 if Asterisk runs on this host).
ASTERISK_HOST=
ASTERISK_PORT=5038
ASTERISK_AMI_USER=alarmcore
ASTERISK_AMI_PASSWORD=
ASTERISK_ANNOUNCEMENT=alarm-announcement
ASTERISK_CHANNEL_TEMPLATE=PJSIP/{number}@out-trunk
# Directory alarm-core writes/reads announcement sound files in; should be
# one of Asterisk's configured sound search paths.
ASTERISK_SOUNDS_DIR=/var/lib/asterisk/sounds/custom

# Text-to-speech for the voice channel (espeak-ng + sox, fully offline).
# If disabled, ASTERISK_ANNOUNCEMENT is played statically for every call
# instead of speaking the actual alert text.
TTS_ENABLED=false
TTS_VOICE=de
TTS_SPEED=0

# SMS channel (SMSEAGLE). Empty by default — disabled until you set
# SMSEAGLE_BASE_URL (e.g. http://smseagle.local).
SMSEAGLE_BASE_URL=
SMSEAGLE_LOGIN=
SMSEAGLE_PASSWORD=

# Email channel (SMTP). Empty by default — disabled until you set SMTP_HOST
# (e.g. smtp.example.org).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@example.org

# Teams channel (Incoming Webhook). Leave TEAMS_WEBHOOK_URL empty to disable.
TEAMS_WEBHOOK_URL=
